{
  "name": "sift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && vite",
    "build": "node scripts/copy-ort.mjs && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-test.mjs",
    "prepare": "node scripts/copy-ort.mjs",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name=sift",
    "deploy:pages": "npm run build && node scripts/deploy-pages.mjs",
    "test:live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
